{
  "manifest_version": 3,
  "name": "Pixiv 收藏原图 → OneDrive",
  "short_name": "Pixiv → OneDrive",
  "version": "1.2.0",
  "description": "在 pixiv.net 收藏作品后，自动把原图保存到 OneDrive\\pixiv，文件名为 pid_pn.ext（n 从 0 开始）。",
  "homepage_url": "https://github.com/Kuenice/pixiv-onedrive",
  "minimum_chrome_version": "110",
  "key": "",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "webRequest",
    "storage",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.pixiv.net/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pixiv.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pixiv 收藏原图 → OneDrive",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}